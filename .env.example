# Supabase Project URL (publiek, mag in client bundle + Vercel env vars)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) — vervangt de legacy "anon" JWT.
# Veilig in browser/client mits RLS aanstaat op je tabellen.
# Naam blijft NEXT_PUBLIC_SUPABASE_ANON_KEY voor compat met Supabase JS / docs.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (sb_secret_...) — vervangt de legacy "service_role" JWT.
# ALLEEN lokaal voor db/seed.ts. NOOIT committen. NOOIT in Vercel zetten.
# Naam blijft SUPABASE_SERVICE_ROLE_KEY voor compat met Supabase JS / docs.
SUPABASE_SERVICE_ROLE_KEY=

# Personal Access Token (sbp_...) — voor de Supabase MCP server, niet voor de app.
# Aanmaken op supabase.com → top-right avatar → Account → Access Tokens.
SUPABASE_ACCESS_TOKEN=
